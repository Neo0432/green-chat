# Start the MSW browser worker in dev mode, so the app runs without GREEN-API credentials ('true' | 'false')
VITE_ENABLE_API_MOCKS=false

# Send GREEN-API requests to the same-origin /green-api prefix, proxied to this host (a fix for CORS), e.g. https://4100.api.green-api.com
# Empty: the app calls the API URL of the instance directly
VITE_GREEN_API_PROXY_TARGET=

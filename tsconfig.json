{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "incremental": true,

    /* Language */
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "allowArbitraryExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Strictness */
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    // Unused locals are policed by @typescript-eslint/no-unused-vars instead.
    "noUnusedLocals": false,

    "skipLibCheck": true,
    // `node` is for the root config files (vite.config.ts, jest.config.ts, ...).
    "types": ["node", "vite/client", "jest", "@testing-library/jest-dom"],

    // No baseUrl: it is deprecated in TS 6, and since TS 5.0 paths resolve
    // relative to the tsconfig itself. Mirrored in vite.config.ts and jest.config.ts.
    "paths": {
      "@app/*": ["./src/app/*"],
      "@pages/*": ["./src/pages/*"],
      "@widgets/*": ["./src/widgets/*"],
      "@features/*": ["./src/features/*"],
      "@entities/*": ["./src/entities/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src", "__tests__", "vite.config.ts", "jest.config.ts", "eslint.config.js", "commitlint.config.js"]
}
